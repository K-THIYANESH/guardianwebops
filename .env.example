# Guardian WebOps Configuration Variables

# -------------------------------------------------------------
# TinyFish Web Research API
# -------------------------------------------------------------
# Obtain your API key from https://agent.tinyfish.ai/api-keys
# When left empty, Guardian WebOps runs safely in deterministic [SIMULATED] mock mode.
TINYFISH_API_KEY=

# -------------------------------------------------------------
# Guardian Swarm Governance & Model Engine
# -------------------------------------------------------------
GUARDIAN_MODEL_NAME=microsoft/Phi-3.5-mini-instruct
GUARDIAN_FALLBACK_MODEL_NAME=HuggingFaceTB/SmolLM2-1.7B-Instruct

# Local folder where checkpoints and embeddings are cached
GUARDIAN_CACHE_DIR=./models

# Acceleration
GUARDIAN_USE_CUDA=False

# Force fast heuristics rules evaluation (ideal for offline / zero-GPU dev)
GUARDIAN_FORCE_HEURISTICS=True

# -------------------------------------------------------------
# Web & Security Configuration
# -------------------------------------------------------------
FLASK_PORT=5000
FLASK_HOST=127.0.0.1
JWT_SECRET=GuardianWebOpsSecretKey2026!
DATABASE_URL=sqlite:///data/guardian_swarm.db
